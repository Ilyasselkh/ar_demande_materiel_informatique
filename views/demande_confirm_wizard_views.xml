<odoo>
    <record id="view_ar_it_demande_confirm_wizard_form" model="ir.ui.view">
        <field name="name">ar.it.demande.confirm.wizard.form</field>
        <field name="model">ar.it.demande.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmation" class="ar_it_confirm_wizard">
                <field name="demande_id" invisible="1"/>
                <field name="action_key" invisible="1"/>
                <field name="title" invisible="1"/>
                <field name="message" invisible="1"/>
                <field name="icon_text" invisible="1"/>
                <field name="is_refusal" invisible="1"/>

                <div class="ar_confirm_box">
                    <div class="ar_confirm_icon">
                        <field name="icon_text" readonly="1" nolabel="1"/>
                    </div>
                    <h2>
                        <field name="title" readonly="1" nolabel="1"/>
                    </h2>
                    <p>
                        <field name="message" readonly="1" nolabel="1"/>
                    </p>
                </div>

                <group invisible="not is_refusal">
                    <field name="refusal_reason"
                           placeholder="Saisir le motif de refus..."
                           required="is_refusal"/>
                </group>

                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirmer"
                            class="btn-primary"/>
                    <button string="Annuler"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
